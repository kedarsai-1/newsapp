# Local development — copied by ../scripts/use-api-env.sh local
# No spaces around '=' (required by flutter_dotenv).

# Leave API_BASE_URL unset so AppConstants picks the right host per platform:
#   iOS simulator / macOS / desktop → http://127.0.0.1:5010/api
#   Android emulator                → http://10.0.2.2:5010/api
# Physical device on Wi‑Fi: set API_HOST to your Mac's LAN IP.
API_HOST=127.0.0.1
API_PORT=5010

APP_NAME=NewsNow
APP_ENV=development
