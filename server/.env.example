# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/news_app?schema=public

# Server
# Use 5001 on macOS — port 5000 is often taken by AirPlay Receiver.
PORT=5001
# Comma or || separated (scheme optional): http://localhost:62042,192.168.1.5:5001
ALLOWED_ORIGINS=localhost:62042
# Requests per IP per minute (health/ready excluded)
RATE_LIMIT_MAX=100

# In-memory HTTP response cache (single Node instance; cleared on ingest)
FEED_CACHE_ENABLED=true
FEED_CACHE_TTL_MS=45000
FEED_CACHE_MAX_PAGE=3
CATEGORIES_CACHE_TTL_MS=300000
POST_CACHE_TTL_MS=120000
# JWT auth (required in production)
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
# Required for manual /api/cron/* triggers only (internal node-cron does not need this).
CRON_SECRET=

# Cricket live scores (https://www.cricapi.com)
CRICAPI_KEY=
# Optional: comma-separated series IDs (IPL 2025 default is built in if search fails)
# CRICAPI_LEAGUE_SERIES_IDS=d5a498c8-7596-4b93-8ab0-e0efc3345312

# RSS ingestion (scheduled via node-cron on server startup)
SCRAPER_ENABLED=true
SCRAPER_CRON=*/5 * * * *
# Per-language ingestion (production): separate pipelines for en / hi / te
# Each run: RSS news → YouTube (shorts) → political (interviews/debates)
INGEST_PER_LANGUAGE=true
# Languages for RSS / YouTube / political pipelines (replaces legacy GNEWS_INGEST_LANGS)
INGEST_LANGUAGES=en,te,hi
# Single-language worker (Railway): set to en, hi, or te — leave blank for all three on one host
# INGEST_WORKER_LANG=te
# Optional staggered crons per language (defaults: en */5, hi 1-59/5, te 2-59/5)
# SCRAPER_CRON_EN=*/5 * * * *
# SCRAPER_CRON_HI=1-59/5 * * * *
# SCRAPER_CRON_TE=2-59/5 * * * *
# Per-language runtime budgets (ms) — falls back to INGEST_MAX_RUNTIME_MS
# INGEST_MAX_RUNTIME_MS_EN=400000
# INGEST_MAX_RUNTIME_MS_HI=400000
# INGEST_MAX_RUNTIME_MS_TE=400000
# Local dev: runs once ~2s after startup. On Railway set SCRAPER_RUN_ON_START=true to enable.
SCRAPER_RUN_ON_START=true
RSS_REQUIRE_IMAGE=true

# Ingestion: trust RSS category tags (set true only to re-enable strict keyword filtering)
INGEST_STRICT_CATEGORY_FILTER=false
# Telugu politics RSS uses built-in political-story filter (no env flag needed).
INGEST_STRICT_POLITICS_FILTER=false
RSS_INSERTS_PER_FEED=6
RSS_SCAN_PER_FEED=30
# Wall-clock cap per scrape run (milliseconds). If unset: 20 min local, 6 min on Railway.
# 400000 ms ≈ 6.7 min — practical Contabo/Ollama starting point; use 600000+ for heavy hi/te runs.
INGEST_MAX_RUNTIME_MS=400000
# Set false to ingest stories without thumbnails (more items per category)
# RSS_REQUIRE_IMAGE=false
# Speed up long runs (feeds are interleaved en/hi/te so all languages get coverage)
# RSS_ENRICH_BODY=false
# RSS_OG_FALLBACK=false
# Fetch article HTML when RSS body is short (for better summaries without full RSS_ENRICH_BODY)
RSS_ENRICH_FOR_SUMMARY=true
# ── AI summaries & translation (Contabo VPS: use Ollama; else Hugging Face) ──
# ollama | huggingface (default)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# Per-language models (recommended on 11 GB VPS)
OLLAMA_MODEL_EN=llama3.1:8b
OLLAMA_MODEL_INDIC=mashriram/sarvam-1
# OLLAMA_MODEL_HI=mashriram/sarvam-1
# OLLAMA_MODEL_TE=mashriram/sarvam-1
OLLAMA_TIMEOUT_MS=90000
# Cache Ollama status in GET /api/health (ms). ?refresh=1 bypasses cache.
OLLAMA_HEALTH_TTL_MS=60000
# Hugging Face fallback when AI_PROVIDER=huggingface
HF_TOKEN=
RSS_INDIC_AI_SUMMARY=true
RSS_SUMMARY_INPUT_MAX_CHARS=2000
RSS_SUMMARY_MIN_CHARS=15
# RSS_SKIP_AI_SUMMARY=true

# YouTube Data API (metadata only — no video download)
YOUTUBE_API_KEY=
YOUTUBE_ENABLED=true
# Search uses ~100 quota units per query; keep false unless you have high quota
YOUTUBE_SEARCH_ENABLED=false
YOUTUBE_CHANNEL_IDS=
YOUTUBE_CHANNEL_IDS_EN=UCwqusr8YDwM-3mEYTDeJHzw
# Telugu (TV9 Telugu — override or add more comma-separated)
YOUTUBE_CHANNEL_IDS_TE=UCumtYpCY26F6Jr3satUgMvA
YOUTUBE_CHANNEL_IDS_HI=UCt4t-jeY85JegMlZ-E5UWtA
YOUTUBE_SEARCH_PER_CATEGORY=5
YOUTUBE_CHANNEL_MAX_PER_RUN=5
YOUTUBE_INSERTS_PER_SOURCE=2
YOUTUBE_DEFAULT_CATEGORY=entertainment
# Every 6 hours (not */15 — avoids burning daily 10k quota)
YOUTUBE_CRON=0 */6 * * *
# Local dev: runs once ~5s after startup. Set YOUTUBE_RUN_ON_START=false to disable.
YOUTUBE_RUN_ON_START=true
YOUTUBE_QUOTA_COOLDOWN_HOURS=24
# Set true only if you do not use a separate external YouTube cron.
YOUTUBE_INGEST_WITH_SCRAPER=false
YOUTUBE_REGION_CODE=IN
YOUTUBE_RELEVANCE_LANG=en

# Political video classification (YouTube + MiniLM, embed-only)
POLITICAL_VIDEO_ENABLED=true
POLITICAL_VIDEO_CRON=*/15 * * * *
# Set POLITICAL_VIDEO_RUN_ON_START=true for a one-time run on local startup
POLITICAL_VIDEO_RUN_ON_START=false
POLITICAL_VIDEOS_PER_CHANNEL=12
# On Railway free/small instances use keywords-only (false). Enable ML on 1GB+ plans.
POLITICAL_ML_ENABLED=false
POLITICAL_ML_PRELOAD=false
POLITICAL_ML_MIN_SCORE=0.42
POLITICAL_ML_MIN_MARGIN=0.04
POLITICAL_ML_BATCH=8
# Comma-separated channel IDs per language (overrides defaults for that language)
POLITICAL_YOUTUBE_CHANNEL_IDS_TE=UCZ9m4KOh8Ei60428xeGYDCQ,UC_2irx_BQR7RsBKmUV9fePQ
POLITICAL_YOUTUBE_CHANNEL_IDS_HI=UCt4t-jeY85JegMlZ-E5UWtA,UC7wXt18f2iA3EDXeqAVuKng
POLITICAL_YOUTUBE_CHANNEL_IDS_EN=UCwqusr8YDwM-3mEYTDeJHzw,UCZFMm1mMw0F81Z37aaEzTUA
# Or full JSON list (takes precedence over the vars above):
# POLITICAL_YOUTUBE_CHANNELS_JSON=[{"channelId":"UC...","language":"te","name":"Channel"}]

# Retention cleanup (scheduled via node-cron)
RETENTION_ENABLED=true
RETENTION_CRON=10 3 * * *
# Set RETENTION_RUN_ON_START=true to purge once on startup (usually not needed)
RETENTION_RUN_ON_START=false
RETENTION_DAYS=7
RETENTION_BATCH=2000
RETENTION_DRY_RUN=false

# Firebase Cloud Messaging (server — service account from Firebase Console)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste private key with literal \n line breaks, or use a single line from JSON
FIREBASE_PRIVATE_KEY=
# Send push when cron ingests new approved stories (topic: all)
PUSH_NOTIFY_ON_INGEST=true
