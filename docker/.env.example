# Copy to docker/.env and adjust before: docker compose up -d --build
#
# cp docker/.env.example docker/.env

# Public URL users open in the browser (must match how you access the web container)
PUBLIC_ORIGIN=http://localhost

# Host ports
WEB_PORT=80
API_PORT=5001

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=news_app

# Required in production (min 32 random chars)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Optional: seed the first admin on first boot
# ADMIN_SEED_PASSWORD=change_me

# Optional: protect manual /api/cron/* triggers
# CRON_SECRET=

# Ollama on the host machine (default) or docker compose --profile ai
OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_MODEL_EN=llama3.1:8b
OLLAMA_MODEL_INDIC=mashriram/sarvam-1
OLLAMA_MODEL_CHAT=gemma2:2b

# When using the bundled Ollama service instead:
# OLLAMA_BASE_URL=http://ollama:11434

# Ingestion (disable on very small VPS if needed)
SCRAPER_ENABLED=true
INGEST_PER_LANGUAGE=true
SCRAPER_RUN_ON_START=false
YOUTUBE_RUN_ON_START=false
POLITICAL_VIDEO_RUN_ON_START=false

# Optional integrations
# YOUTUBE_API_KEY=
# CRICAPI_KEY=
# HF_TOKEN=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
