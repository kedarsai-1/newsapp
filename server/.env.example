# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/news_app?schema=public

# Server
# Use 5001 on macOS — port 5000 is often taken by AirPlay Receiver.
PORT=5001
# Bind address. Use 127.0.0.1 behind nginx; 0.0.0.0 for direct exposure (dev only).
# HOST=127.0.0.1
# Trust X-Forwarded-* from reverse proxy (nginx). Required in production behind nginx.
# TRUST_PROXY=true
# Comma or || separated (scheme optional): http://localhost:62042,192.168.1.5:5001
ALLOWED_ORIGINS=localhost:62042
# Dev: any localhost origin is allowed when NODE_ENV is not production.
# Production VPS + Flutter web: set CORS_ALLOW_LOCALHOST=true explicitly.
# CORS_ALLOW_LOCALHOST=false
# Requests per IP per minute (health/ready excluded)
RATE_LIMIT_MAX=200
# Higher limit for public GET feeds, categories, weather, sports reads
RATE_LIMIT_READ_MAX=800
# Stricter limit for POST /api/news/chat and /api/news/translate (per IP per minute)
# AI_RATE_LIMIT_MAX=20

# Edge / CDN cache headers on anonymous public GETs (Cloudflare, nginx proxy_cache)
EDGE_CACHE_ENABLED=true
# CDN edge TTL in seconds (browser uses FEED_CACHE_TTL_MS / server Redis cache)
CDN_CACHE_TTL_SEC=30

# Optional Redis (falls back to in-process memory if unset or unreachable)
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_HOST=127.0.0.1

# In-memory HTTP response cache (single Node instance; cleared on ingest)
FEED_CACHE_ENABLED=true
FEED_CACHE_TTL_MS=45000
# Longer Redis/in-process cache for Hindi/Telugu feeds (reduces scan-loop load)
FEED_INDIC_CACHE_TTL_MS=90000
FEED_CACHE_MAX_PAGE=3
# Max DB rows scanned when post-filters shrink pages (Shorts, English script filter, etc.)
# FEED_MAX_SCAN_ROWS=800
# Max YouTube items per mixed feed page (when sourceTypes includes youtube + others)
# MAX_YOUTUBE_IN_MIXED_FEED=2
POLITICAL_FEED_CACHE_TTL_MS=45000
CATEGORIES_CACHE_TTL_MS=300000
POST_CACHE_TTL_MS=120000
# JWT auth (required in production)
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d
# Required for manual /api/cron/* triggers only (internal node-cron does not need this).
CRON_SECRET=

# Location-based weather (Open-Meteo — free, no API key)
# By GPS:   GET /api/weather?lat=17.385&lng=78.4867
# By city:  GET /api/weather?city=Hyderabad&state=Telangana
# WEATHER_CACHE_TTL_MS=600000
# WEATHER_FORECAST_DAYS=7
# WEATHER_HOURLY_LIMIT=24
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# AI news chat (POST /api/news/chat) — Dailyhunt-style news companion (requires Ollama)
# Body: {
#   "message": "What happened in Andhra politics?",
#   "language": "en|hi|te",
#   "articleId": "optional-uuid-from-article-screen",
#   "category": "politics",
#   "city": "Hyderabad",
#   "latitude": 17.38, "longitude": 78.48,
#   "history": [{ "role": "user", "content": "..." }, { "role": "assistant", "content": "..." }]
# }
# Location is optional — improves weather answers; all other topics use ingested news.
# CHAT_CONTEXT_DAYS=30
# CHAT_MAX_ARTICLES=6
# CHAT_ARTICLE_SUMMARY_CHARS=320
# CHAT_ARTICLE_BODY_CHARS=400
# CHAT_INCLUDE_BODY=false
# CHAT_MAX_HISTORY_TURNS=4
# CHAT_CONTEXT_TIMEOUT_MS=8000
CHAT_REQUEST_TIMEOUT_MS=60000
# Per-request wall clock (queue-aware): context + (queueIndex+1)*OLLAMA_CHAT_TIMEOUT_MS + buffer
# CHAT_HANDLER_TIMEOUT_MS_CAP=360000
# CHAT_HANDLER_TIMEOUT_BUFFER_MS=5000
# Ollama inference budget for chat (must stay below per-slot handler budget)
OLLAMA_CHAT_TIMEOUT_MS=58000
OLLAMA_CHAT_MAX_TOKENS=120
# Chat uses a fast model separate from ingest summarization (see OLLAMA_MODEL_* below)
# Optional second Ollama instance — leave blank to share OLLAMA_BASE_URL
# OLLAMA_CHAT_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL_CHAT=gemma2:2b
OLLAMA_MODEL_CHAT_EN=gemma2:2b
OLLAMA_MODEL_CHAT_HI=gemma2:2b
OLLAMA_MODEL_CHAT_TE=gemma2:2b
OLLAMA_KEEP_ALIVE=15m
OLLAMA_WARM_ON_START=true
# Warm chat models on startup + periodic interval (sequential; does not block listen)
OLLAMA_WARM_LANGS=en,hi,te
OLLAMA_WARM_TIMEOUT_MS=25000
OLLAMA_WARM_INTERVAL_MS=900000
# TRANSLATE_REQUEST_TIMEOUT_MS=90000

# Cricket live scores (https://www.cricapi.com)
CRICAPI_KEY=
# Optional: comma-separated series IDs (IPL 2025 default is built in if search fails)
# CRICAPI_LEAGUE_SERIES_IDS=d5a498c8-7596-4b93-8ab0-e0efc3345312

# RSS ingestion (scheduled via node-cron on server startup)
SCRAPER_ENABLED=true
# Legacy fallback when per-language crons are unset (en uses SCRAPER_CRON_EN or this)
SCRAPER_CRON=*/15 * * * *
# Per-language ingestion (production): separate pipelines for en / hi / te
# Each run: RSS news → YouTube (shorts) → political (interviews/debates)
INGEST_PER_LANGUAGE=true
# Staggered crons (recommended on single VPS with Ollama) — one language at a time
INGEST_PARALLEL_LANGUAGES=false
# Languages for RSS / YouTube / political pipelines (replaces legacy GNEWS_INGEST_LANGS)
INGEST_LANGUAGES=en,te,hi
# Single-language worker (Railway): set to en, hi, or te — leave blank for all three on one host
# INGEST_WORKER_LANG=te
# Staggered crons: 5 min apart so en/hi/te never hit Ollama together (avoids chat timeouts)
# en :00/:15/:30/:45 — hi :05/:20/:35/:50 — te :10/:25/:40/:55
SCRAPER_CRON_EN=*/15 * * * *
SCRAPER_CRON_HI=5-59/15 * * * *
SCRAPER_CRON_TE=10-59/15 * * * *
# Per-language runtime budgets (ms) — falls back to INGEST_MAX_RUNTIME_MS
# INGEST_MAX_RUNTIME_MS_EN=400000
# INGEST_MAX_RUNTIME_MS_HI=400000
# INGEST_MAX_RUNTIME_MS_TE=400000
# Local dev: runs once ~2s after startup. On Railway set SCRAPER_RUN_ON_START=true to enable.
SCRAPER_RUN_ON_START=true
RSS_REQUIRE_IMAGE=true

# Strict category matching for sports/entertainment/business/etc. (default on)
INGEST_STRICT_CATEGORY_FILTER=true
# Optional: require 2+ political signals on hi/te politics RSS (default: noise-only on section feeds)
INGEST_STRICT_POLITICS_FILTER=false
RSS_INSERTS_PER_FEED=6
RSS_SCAN_PER_FEED=30
# Wall-clock cap per scrape run (milliseconds). If unset: 20 min local, 6 min on Railway.
# 400000 ms ≈ 6.7 min — practical Contabo/Ollama starting point; use 600000+ for heavy hi/te runs.
INGEST_MAX_RUNTIME_MS=400000
# Set false to ingest stories without thumbnails (more items per category)
# RSS_REQUIRE_IMAGE=false
# Speed up long runs (feeds are interleaved en/hi/te so all languages get coverage)
# RSS_ENRICH_BODY=false
# Fetch og:image when RSS has no media tag (recommended for en/hi/te cards)
# RSS_OG_FALLBACK=false
# Re-host hotlinked images to Cloudinary (stable thumbnails in Flutter cards)
INGEST_REHOST_IMAGES=true
# Fetch article HTML when RSS body is short (for better summaries without full RSS_ENRICH_BODY)
RSS_ENRICH_FOR_SUMMARY=true
# ── AI summaries & translation (Contabo VPS: use Ollama; else Hugging Face) ──
# ollama | huggingface (default)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# With chat + ingest models, set OLLAMA_MAX_LOADED_MODELS=2 (see docs/OLLAMA_SETUP.md)
OLLAMA_MODEL=llama3.1:8b
# Ingest summarization models (recommended on 11 GB VPS)
OLLAMA_MODEL_EN=llama3.1:8b
OLLAMA_MODEL_INDIC=mashriram/sarvam-1
# OLLAMA_MODEL_HI=mashriram/sarvam-1
# OLLAMA_MODEL_TE=mashriram/sarvam-1
OLLAMA_TIMEOUT_MS=90000
OLLAMA_SUMMARY_TIMEOUT_MS=90000
OLLAMA_SUMMARY_MIN_BUDGET_MS=55000
INGEST_SUMMARY_MAX_RETRIES=1
# Shorts tab: block political YouTube from main Shorts feed (political reels tab is separate)
SHORTS_STRICT_NO_POLITICS=true
# Semantic shorts dedupe via Ollama when AI_PROVIDER=ollama (enabled unless set to false)
OLLAMA_YOUTUBE_DEDUPE=true
# OLLAMA_YOUTUBE_DEDUPE_MAX=8
# Cache Ollama status in GET /api/health (ms). ?refresh=1 bypasses cache.
OLLAMA_HEALTH_TTL_MS=60000
# Hugging Face fallback when AI_PROVIDER=huggingface
HF_TOKEN=
RSS_INDIC_AI_SUMMARY=true
RSS_SUMMARY_INPUT_MAX_CHARS=2000
RSS_SUMMARY_MIN_CHARS=15
# Production: keep false so en/hi/te get Ollama summaries on ingest
RSS_SKIP_AI_SUMMARY=false

# YouTube Data API (metadata only — no video download)
YOUTUBE_API_KEY=
YOUTUBE_ENABLED=true
# Search uses ~100 quota units per query; keep false unless you have high quota
YOUTUBE_SEARCH_ENABLED=false
YOUTUBE_CHANNEL_IDS=
YOUTUBE_CHANNEL_IDS_EN=UCwqusr8YDwM-3mEYTDeJHzw
# Telugu (TV9 Telugu — override or add more comma-separated)
YOUTUBE_CHANNEL_IDS_TE=UCumtYpCY26F6Jr3satUgMvA
YOUTUBE_CHANNEL_IDS_HI=UCt4t-jeY85JegMlZ-E5UWtA
YOUTUBE_SEARCH_PER_CATEGORY=5
YOUTUBE_CHANNEL_MAX_PER_RUN=5
YOUTUBE_INSERTS_PER_SOURCE=2
YOUTUBE_DEFAULT_CATEGORY=entertainment
# Every 6 hours (not */15 — avoids burning daily 10k quota)
YOUTUBE_CRON=0 */6 * * *
# Local dev: runs once ~5s after startup. Set YOUTUBE_RUN_ON_START=false to disable.
YOUTUBE_RUN_ON_START=true
YOUTUBE_QUOTA_COOLDOWN_HOURS=24
# Set true only if you do not use a separate external YouTube cron.
YOUTUBE_INGEST_WITH_SCRAPER=false
YOUTUBE_REGION_CODE=IN
YOUTUBE_RELEVANCE_LANG=en

# Political video classification (YouTube + MiniLM, embed-only)
POLITICAL_VIDEO_ENABLED=true
POLITICAL_VIDEO_CRON=*/15 * * * *
# Set POLITICAL_VIDEO_RUN_ON_START=true for a one-time run on local startup
POLITICAL_VIDEO_RUN_ON_START=false
POLITICAL_VIDEOS_PER_CHANNEL=12
# On Railway free/small instances use keywords-only (false). Enable ML on 1GB+ plans.
POLITICAL_ML_ENABLED=false
POLITICAL_ML_PRELOAD=false
POLITICAL_ML_MIN_SCORE=0.42
POLITICAL_ML_MIN_MARGIN=0.04
POLITICAL_ML_BATCH=8
# Comma-separated channel IDs per language (overrides defaults for that language)
POLITICAL_YOUTUBE_CHANNEL_IDS_TE=UCZ9m4KOh8Ei60428xeGYDCQ,UC_2irx_BQR7RsBKmUV9fePQ
POLITICAL_YOUTUBE_CHANNEL_IDS_HI=UCt4t-jeY85JegMlZ-E5UWtA,UC7wXt18f2iA3EDXeqAVuKng
POLITICAL_YOUTUBE_CHANNEL_IDS_EN=UCwqusr8YDwM-3mEYTDeJHzw,UCZFMm1mMw0F81Z37aaEzTUA
# Or full JSON list (takes precedence over the vars above):
# POLITICAL_YOUTUBE_CHANNELS_JSON=[{"channelId":"UC...","language":"te","name":"Channel"}]

# Retention cleanup (scheduled via node-cron)
RETENTION_ENABLED=true
RETENTION_CRON=10 3 * * *
# Set RETENTION_RUN_ON_START=true to purge once on startup (usually not needed)
RETENTION_RUN_ON_START=false
RETENTION_DAYS=7
RETENTION_BATCH=2000
RETENTION_DRY_RUN=false

# Firebase Cloud Messaging (server — service account from Firebase Console)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste private key with literal \n line breaks, or use a single line from JSON
FIREBASE_PRIVATE_KEY=
# Send push when cron ingests new approved stories (topic: all)
PUSH_NOTIFY_ON_INGEST=true
# Minimum new rows in one ingest batch before sending a bulk push (default 5)
PUSH_MIN_INSERTED=5
# Minimum ms between ingest bulk pushes (default 900000 = 15 min)
PUSH_INGEST_COOLDOWN_MS=900000
# Comma-separated ingest sources allowed to trigger bulk push (news only by default)
PUSH_INGEST_SOURCES=news
# Also send to FCM topic "breaking" when a story is marked breaking (default true)
PUSH_NOTIFY_BREAKING_TOPIC=true
# Clear users.fcm_token when FCM reports an invalid/expired token (default true)
FCM_PRUNE_INVALID_TOKENS=true
# Max PUT /api/auth/fcm-token requests per user per minute
FCM_TOKEN_RATE_LIMIT_MAX=10

# In-process cache fallback (when Redis unavailable)
CACHE_MAX_MEMORY_ENTRIES=200
CACHE_SWEEP_MS=60000
