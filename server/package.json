{
  "name": "news-app-server",
  "version": "1.0.0",
  "description": "Way2News-style backend API",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "seed:admin": "node -e \"require('dotenv').config(); require('./utils/ensureDefaultData').ensureDefaultAdmin().then((created) => { console.log(created ? 'Admin provisioned' : 'Admin already exists'); return require('./config/prisma').prisma.$disconnect(); }).then(() => process.exit(0)).catch((e) => { console.error(e); process.exit(1); })\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "test": "sh -c \"node --test test/middleware/*.test.js test/utils/*.test.js test/controllers/*.test.js test/services/*.test.js\""
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@xenova/transformers": "^2.17.2",
    "axios": "^1.16.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "firebase-admin": "^11.11.1",
    "franc": "^6.2.0",
    "jsdom": "^29.0.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.9",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "rss-parser": "^3.13.0",
    "redis": "^4.7.0",
    "socket.io": "^4.7.2",
    "twilio": "^4.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
