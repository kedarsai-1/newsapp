# Production — copied by ../scripts/use-api-env.sh production
# No spaces around '=' (required by flutter_dotenv).
# Public release builds MUST use HTTPS for API_BASE_URL and SOCKET_URL.

# ── Railway (recommended) ─────────────────────────────────────────────
API_BASE_URL=https://your-service.up.railway.app/api
