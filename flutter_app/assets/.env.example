# Copy to assets/.env (never commit secrets).
# No spaces around '='.

# ── Railway (recommended) ─────────────────────────────────────────────
# Use your PUBLIC Railway URL. Port 8080 is internal only — do not put :8080 in the app.
API_BASE_URL=https://your-service.up.railway.app/api
# Local political-videos testing (server must be running on PORT):
# API_BASE_URL=http://127.0.0.1:5001/api
SOCKET_URL=https://your-service.up.railway.app

# ── Local dev (macOS: avoid 5000 — AirPlay uses it) ───────────────────
# API_HOST=127.0.0.1
# API_PORT=5001

APP_NAME=NewsNow

# Public web origin for short share links (http://host/n/{code}) — required for mobile offline share fallback.
# SHARE_WEB_BASE_URL=http://147.93.169.3

# Firebase push (mobile) — see docs/FIREBASE_SETUP.md
# 1. Add platform files from Firebase Console:
#    - android/app/google-services.json
#    - ios/Runner/GoogleService-Info.plist
# 2. Generate lib/firebase_options.dart:
#    dart pub global activate flutterfire_cli && flutterfire configure
